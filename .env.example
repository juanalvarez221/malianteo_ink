# Copia este archivo como .env.local y completa lo que necesites.
# Sin estas variables el flujo de cotización igual funciona en local:
# las cotizaciones y asesorías se guardan en la carpeta data/ y los correos
# se muestran en la consola como vista previa.

# ─── Sitio ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Seguridad / agenda ────────────────────────────────────────────
# Secreto para firmar sesiones y límites de peticiones (cadena larga aleatoria).
ADMIN_SESSION_SECRET=
# PIN para publicar/editar cupos de asesoría vía PUT /api/advisory/slots.
ADVISORY_ADMIN_PIN=

# ─── Base de datos (Postgres / Neon) — recomendado en producción ───
# DATABASE_URL=postgresql://usuario:clave@host/db?sslmode=require

# ─── Almacenamiento de agenda en producción (Upstash Redis) ─────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Correo (Gmail SMTP con contraseña de aplicación) ───────────────
# GMAIL_SMTP_USER=cuenta-de-marca@gmail.com
# GMAIL_SMTP_APP_PASSWORD=
# GMAIL_FROM_EMAIL=Malianteo Ink <cuenta-de-marca@gmail.com>
# GMAIL_REPLY_TO=
# Bandeja donde Malianteo recibe los avisos de nuevas cotizaciones/asesorías:
# ARTIST_NOTIFICATIONS_EMAIL=

# ─── Google Calendar (opcional) ─────────────────────────────────────
# GOOGLE_CALENDAR_ENABLED=false
# GOOGLE_CALENDAR_ID=
# GOOGLE_MEET_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_CREATE_MEET=true

# ─── WhatsApp (Twilio, opcional) ────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
